      "kind_plural_type_parameter": "Parâmetros de tipo",
      "kind_plural_variable": "Variáveis",
      "theme_defined_in": "Definido em",
      "theme_implementation_of": "Implementa",
      "theme_implemented_by": "Implementado por",
      "theme_implements": "Implementa",
      "theme_inherited_from": "Herdado de",
      "theme_overrides": "Sobrescreve",
