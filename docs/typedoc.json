{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "../packages/vitral/src/index.ts",
    "../packages/vitral/src/element.ts",
    "../packages/vitral/src/react.tsx",
    "../packages/vitral/src/vue.ts",
    "../packages/vitral/src/angular.ts",
    "../packages/vitral/src/svelte.ts",
    "../packages/vitral/src/solid.ts",
    "../packages/vitral/src/preact.ts",
    "../packages/vitral/src/testing.ts",
    "../packages/vitral/src/vite.ts",
    "../packages/vitral/src/sentry.ts",
    "../packages/vitral/src/otel.ts",
    "../packages/vitral/src/single-spa.ts",
    "../packages/vitral/src/federation.ts",
    "../packages/vitral/src/prefetch.ts"
  ],
  "tsconfig": "../packages/vitral/tsconfig.json",
  "out": "api",
  "docsRoot": ".",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme",
    "./scripts/typedoc-vitral.mjs"
  ],
  "readme": "none",
  "disableSources": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "sidebar": {
    "pretty": true
  },
  "excludeExternals": true,
  "lang": "pt",
  "locales": {
    "pt": {
      "kind_accessor": "Acessor",
      "kind_call_signature": "Assinatura",
      "kind_class": "Classe",
      "kind_constructor": "Construtor",
      "kind_function": "Função",
      "kind_get_signature": "Get",
      "kind_index_signature": "Assinatura de índice",
      "kind_interface": "Interface",
      "kind_method": "Método",
      "kind_module": "Módulo",
      "kind_property": "Propriedade",
      "kind_set_signature": "Set",
      "kind_type_alias": "Tipo",
      "kind_variable": "Variável",
      "kind_plural_accessor": "Acessores",
      "kind_plural_class": "Classes",
      "kind_plural_constructor": "Construtores",
      "kind_plural_function": "Funções",
