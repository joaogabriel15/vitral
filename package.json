{
  "name": "ilha-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build",
    "build:all": "pnpm build && pnpm -r --filter './demo/**' --filter './examples/**' build",
    "test": "pnpm -r --filter ./packages/** test",
    "test:e2e": "pnpm build:all && pnpm --dir e2e test",
    "demo": "pnpm build:all && node demo/serve.mjs",
    "examples": "pnpm build:all && node examples/serve.mjs"
  }
}
