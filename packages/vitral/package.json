{
  "name": "vitral",
  "version": "0.1.0",
  "description": "Micro-frontends sem burocracia: um contrato mount/unmount, carregamento em runtime e adaptadores para React, Next, Vue, Nuxt, Angular, Svelte, Solid, Preact, Lit e JS/TS puro.",
  "keywords": [
    "micro-frontend",
    "microfrontends",
    "module-federation",
    "single-spa",
    "react",
    "nextjs",
    "vue",
    "nuxt",
    "angular",
    "svelte",
    "solid",
    "preact",
    "lit",
    "web-components",
    "vite"
  ],
  "homepage": "https://github.com/joaogabriel15/vitral#readme",
  "bugs": {
    "url": "https://github.com/joaogabriel15/vitral/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaogabriel15/vitral.git",
    "directory": "packages/vitral"
  },
  "license": "MIT",
  "author": "João (https://github.com/joaogabriel15)",
  "type": "module",
  "bin": {
    "vitral": "./dist/cli.js"
  },
  "sideEffects": [
    "./dist/auto.js"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p test/types",
    "lint:pkg": "publint --strict && attw --pack --profile esm-only",
    "size": "size-limit",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "postpack": "rm -f README.md LICENSE"
  },
  "dependencies": {
    "postcss": "^8.5.30"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "@angular/platform-browser": ">=17",
    "preact": ">=10",
    "react": ">=18",
    "react-dom": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=5",
    "typescript": ">=5",
    "vite": ">=5",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "^20.0.0",
    "preact": "^10.29.8",
    "publint": "^0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.2",
    "size-limit": "^11.2.0",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.2",
    "tsup": "^8.5.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.0"
  },
  "size-limit": [
    {
      "name": "host mínimo",
      "path": "dist/index.js",
      "import": "{ configure, createSlot }",
      "ignore": [
        "./overrides-*"
      ],
      "limit": "4 kB"
    },
    {
      "name": "núcleo",
      "path": "dist/index.js",
      "limit": "5 kB"
    },
    {
      "name": "react",
      "path": "dist/react.js",
      "import": "{ Remote, reactRemote }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "6 kB"
    },
    {
      "name": "vue",
      "path": "dist/vue.js",
      "import": "{ VitralRemote, vueRemote }",
      "ignore": [
        "vue"
      ],
      "limit": "6 kB"
    },
    {
      "name": "element",
      "path": "dist/element.js",
      "import": "{ defineVitralElement }",
      "limit": "6 kB"
    },
    {
      "name": "devtools",
      "path": "dist/devtools.js",
      "import": "{ devtools }",
      "limit": "2 kB"
    },
    {
      "name": "auto",
      "path": "dist/auto.js",
      "limit": "6 kB"
    }
  ]
}
